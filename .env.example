NODE_ENV=development
PORT=3001
CHAIN=bsc-testnet
BSC_MAINNET_RPC_URL=
BSC_TESTNET_RPC_URL=
READ_ONLY_WALLET_ADDRESS=
PRIVATE_KEY=
MAX_TRADE_USD=25
DEFAULT_SLIPPAGE_PERCENT=0.50
MAX_SLIPPAGE_PERCENT=1.00
MAX_PRICE_IMPACT_PERCENT=5.00
QUOTE_TTL_SECONDS=30
ENABLE_LIVE_TRADING=false
PERPS_MODE=paper
ENABLE_LIVE_PERPS=false
ALLOW_LIVE_SWITCH=true

# Supabase Auth & Postgres Persistence
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PERPS_INITIAL_BALANCE_USD=10000
PERPS_MAX_ORDER_USD=1000
PERPS_MAX_LEVERAGE=3
# Public, read-only Binance USD-M reference feed for PancakeSwap Perps V2. Zero Aster dependencies.
PERPS_MARK_PROVIDER=binance-usdm
PERPS_MARK_PRICE_URL=https://fapi.binance.com
PERPS_MARK_POLL_MS=3000
PERPS_MARK_STALE_MS=15000
